# Aplicación
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
TICKETS_URL=https://tickets.findyourfrequency.com.mx

# Base de Datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=signal33
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS (dominios locales y findyourfrequency.com.mx permitidos por defecto)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://tickets.findyourfrequency.com.mx

# Uploads
# local | azure (azure requiere AZURE_STORAGE_CONNECTION_STRING; STORAGE_BUCKET = nombre del contenedor)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# Pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=

# Email (Resend)
RESEND_API_KEY=
# el dominio findyourfrequency.com.mx tiene que estar verificado en Resend (DNS SPF/DKIM)
RESEND_FROM_EMAIL=FYF Tickets <tickets@findyourfrequency.com.mx>

# Google Wallet (Opcional - Pases de boletos en Android/Google Wallet)
# Obtén tu Issuer ID y Service Account Key en Google Pay & Wallet Console
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# Logs
LOG_LEVEL=info
