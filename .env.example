# Aplicación
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# dominio público: lo usa Caddy para sacar el certificado HTTPS (docker compose)
SITE_DOMAIN=localhost

# Base de Datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=signal33
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# conexiones simultáneas a Postgres por instancia (ver max_connections del servidor)
DATABASE_POOL_MAX=20

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Uploads
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_API_KEY=

# Pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=

# Email (Resend)
RESEND_API_KEY=
# el dominio findyourfrequency.com tiene que estar verificado en Resend (DNS SPF/DKIM)
RESEND_FROM_EMAIL=SIGNAL33 <signal@findyourfrequency.com>
# envíos simultáneos: 2 es el límite del plan gratuito de Resend
EMAIL_QUEUE_CONCURRENCY=2

# Logs
LOG_LEVEL=info
